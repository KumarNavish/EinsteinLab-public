/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(), camera=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; connect-src 'self' https://www.google.com/recaptcha/; img-src 'self' data: https://www.gstatic.com/recaptcha/; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

/character/*
  Access-Control-Allow-Origin: https://einstein-mobiliar-lab.fastapicloud.dev
  Access-Control-Allow-Methods: GET, HEAD
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
